# Database
DATABASE_URL="postgresql://helpdesk:helpdesk123@localhost:5432/helpdesk?schema=public"

# Redis (for BullMQ)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-change-this-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Email (SMTP)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Helpdesk <support@yourcompany.com>"
SMTP_ENCRYPTION_KEY="your-super-secret-encryption-key-change-this-in-production"

# File Storage
FILE_STORAGE_TYPE="local"  # or "s3"
FILE_UPLOAD_MAX_SIZE=5242880  # 5MB
UPLOAD_PATH="./uploads"

# AWS S3 (optional, for production)
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""

# Application
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
NODE_ENV="development"
PORT=3001

# SLA
SLA_CHECK_INTERVAL=300000  # 5 minutes in ms
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00
BUSINESS_DAYS="1,2,3,4,5"  # Mon-Fri

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN="http://localhost:3000"